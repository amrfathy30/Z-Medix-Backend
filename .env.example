APP_NAME=Starter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://app.test
ADMIN_DOMAIN=admin.app.test
ADMIN_URL=http://admin.app.test
SESSION_DOMAIN=.app.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Host-relative URL used for same-origin Filament previews of public media.
FILAMENT_STORAGE_URL=/storage
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Auth Features
# Test OTP bypass. Leave both blank to keep it disabled; never enable on production.
AUTH_TEST_OTP_CODE=
AUTH_TEST_OTP_ENVIRONMENTS=
SUPER_ADMIN_EMAIL=admin@pulvent.com
FRONTEND_URL=http://localhost:3000
AUTH_PASSWORD_RESET_PATH=/reset-password
AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=15
AUTH_EMAIL_VERIFIED_SUCCESS_PATH=/email/verified?status=success
AUTH_EMAIL_VERIFIED_FAILED_PATH=/email/verified?status=failed

# Phone Service
PHONE_DEFAULT_COUNTRY=EG
# PHONE_ALLOWED_COUNTRIES=EG,SA,AE,KW,QA,BH,OM,JO,LB,IQ,LY,TN,MA,SD
PHONE_UNIQUE_GLOBALLY=true
PHONE_MAX_PER_OWNER=3
PHONE_OTP_EXPIRY_MINUTES=10
PHONE_VERIFICATION_PROVIDER=twilio_verify

# Twilio Verify (https://www.twilio.com/verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
